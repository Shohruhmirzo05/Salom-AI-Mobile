<?xml version="1.0" encoding="utf-8"?>
<!--
    This app stores nothing worth transferring: the session, cookies and all
    local state belong to Chrome, not to us. Excluding everything avoids moving
    stale splash bitmaps and shortcut state between devices.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
