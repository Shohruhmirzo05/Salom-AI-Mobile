<?xml version="1.0" encoding="utf-8"?>
<!-- Brand cyan→purple gradient pill, matching the primary CTA on the web app. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:startColor="#3AA6D4"
                android:endColor="#8F49D1"
                android:angle="0" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:startColor="@color/brand_cyan"
                android:endColor="@color/brand_purple"
                android:angle="0" />
        </shape>
    </item>
</selector>
